{
  "name": "openchamber-ticket-board",
  "version": "0.13.0",
  "private": true,
  "description": "A local-first ticket board for OpenChamber that reads Matt Pocock ticket files and links tickets to real OpenCode sessions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/openchamber-ticket-board.git"
  },
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "kanban-board",
        "name": "Kanban",
        "icon": "task",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/page.html",
        "title": "Kanban board"
      },
      "capabilities": [
        "sessions",
        "prompt"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": ["git"]
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@openchamber/sdk": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
